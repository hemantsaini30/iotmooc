# ---- Server (set in Vercel > Project > Settings > Environment Variables) ----
# MongoDB Atlas connection string. NEVER prefix with VITE_ (that would expose it to the browser).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/iotmooc?retryWrites=true&w=majority
# Optional: port for the local API server (npm run dev:api)
PORT=5000

# ---- Frontend (optional) ----
# Leave empty when frontend and API are deployed together on Vercel (same origin).
# Only set if the API is hosted at a different URL, e.g. https://my-api.vercel.app
VITE_API_URL=
